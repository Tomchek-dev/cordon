// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  TEXT
  VOICE
  DM
}

enum ChannelRole {
  OWNER
  ADMIN
  MEMBER
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  BUSY
}

enum UserRole {
  ADMIN
  MOD
  MEMBER
}

enum BotEventType {
  REMINDER
  NOTIFICATION
  REPORT
}

enum CalendarVisibility {
  PERSONAL
  GENERAL
}

enum DockDirection {
  IN
  OUT
}

enum DockUnitType {
  BIN
  PALLET
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  displayName  String
  passwordHash String
  avatar       String?
  status       UserStatus @default(OFFLINE)
  role         UserRole   @default(MEMBER)
  notifyDmOnly Boolean    @default(false)
  createdAt    DateTime   @default(now())

  memberships       ChannelMember[]
  messages          Message[]
  ownedBots         Bot[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]
  reactions         MessageReaction[]
  calendarEvents    CalendarEvent[]
  pickups           Pickup[]
  dockLogs          DockLog[]
  roleAssignments   RoleAssignment[]

  @@map("users")
}

model Channel {
  id                    String      @id @default(uuid())
  name                  String
  type                  ChannelType @default(TEXT)
  isPrivate             Boolean     @default(false)
  avatar                String?
  isAnnouncementChannel Boolean     @default(false)
  // Set only on a DM-shaped channel that's "with" a bot instead of a second
  // user - see Bot.dmEnabled. No ChannelMember row for the bot itself.
  botId                 String?
  createdAt             DateTime    @default(now())

  members        ChannelMember[]
  messages       Message[]
  dailyReports   DailyReport[]
  calendarEvents CalendarEvent[]
  pickupRotation PickupRotation?
  pickups        Pickup[]
  dockLogs       DockLog[]
  roleAccess     ChannelRoleAccess[]
  bot            Bot?                @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@map("channels")
}

model ChannelMember {
  channelId  String
  userId     String
  role       ChannelRole @default(MEMBER)
  joinedAt   DateTime    @default(now())
  lastReadAt DateTime    @default(now())
  muted      Boolean     @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@map("channel_members")
}

model Message {
  id                 String    @id @default(uuid())
  channelId          String
  authorId           String?
  botId              String?
  content            String
  createdAt          DateTime  @default(now())
  editedAt           DateTime?
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  pinnedAt           DateTime?
  replyToId          String?

  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  bot       Bot?              @relation(fields: [botId], references: [id], onDelete: SetNull)
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReplies")
  reactions MessageReaction[]

  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model Bot {
  id          String   @id @default(uuid())
  name        String
  tokenHash   String   @unique
  // null = a built-in system bot (e.g. the Reminder Bot) with no human owner.
  ownerId     String?
  webhookUrl  String?
  permissions String[]
  // Whether this bot can be opened as a DM and chatted with directly (no
  // command prefix needed) - see Channel.botId.
  dmEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  messages   Message[]
  events     BotEvent[]
  dmChannels Channel[]

  @@map("bots")
}

model BotEvent {
  id           String       @id @default(uuid())
  botId        String
  type         BotEventType
  payload      Json
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime     @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_events")
}

model DailyReport {
  id          String   @id @default(uuid())
  date        DateTime
  channelId   String
  content     String
  generatedAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("daily_reports")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  // Keep the log entry even if the acting user is later deleted - who did
  // what matters more than whether that account still exists.
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model CalendarEvent {
  id           String             @id @default(uuid())
  title        String
  notes        String?
  date         DateTime
  visibility   CalendarVisibility @default(PERSONAL)
  createdById  String
  // Required for GENERAL events - which channel the reminder posts into.
  channelId    String?
  reminderSent Boolean            @default(false)
  createdAt    DateTime           @default(now())

  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

// One rotation per channel - tracks whose turn is next for !me pickup claims.
model PickupRotation {
  channelId    String   @id
  memberOrder  String[]
  currentIndex Int      @default(0)
  updatedAt    DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("pickup_rotations")
}

model Pickup {
  id           String   @id @default(uuid())
  channelId    String
  assignedToId String
  labelUrl     String
  createdAt    DateTime @default(now())

  channel    Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  assignedTo User    @relation(fields: [assignedToId], references: [id], onDelete: Cascade)

  @@map("pickups")
}

model DockLog {
  id          String        @id @default(uuid())
  channelId   String
  direction   DockDirection
  unitType    DockUnitType
  quantity    Int
  destination String?
  loggedById  String
  createdAt   DateTime      @default(now())

  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  loggedBy User    @relation(fields: [loggedById], references: [id], onDelete: Cascade)

  @@map("dock_logs")
}

// Custom, admin-managed groups (distinct from the fixed UserRole site-permission
// enum and the per-channel ChannelRole enum) - used only to grant additional
// access to role-restricted private channels.
model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  assignments   RoleAssignment[]
  channelAccess ChannelRoleAccess[]

  @@map("roles")
}

model RoleAssignment {
  roleId String
  userId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roleId, userId])
  @@map("role_assignments")
}

model ChannelRoleAccess {
  roleId    String
  channelId String

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([roleId, channelId])
  @@map("channel_role_access")
}
