{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Internal Chat",
  "version": "0.1.0",
  "identifier": "com.era.internalchat",
  "build": {
    "frontendDist": "https://pop-os.local",
    "devUrl": "https://pop-os.local"
  },
  "app": {
    "windows": [
      {
        "title": "Internal Chat",
        "url": "https://pop-os.local",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
