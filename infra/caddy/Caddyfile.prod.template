{
	auto_https off
}

http://${LAN_HOSTNAME}, http://${LAN_IP}, http://localhost {
	redir https://{host}{uri} permanent
}

https://${LAN_HOSTNAME}, https://${LAN_IP}, https://localhost {
	tls /etc/caddy/certs/lan.pem /etc/caddy/certs/lan-key.pem

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@backend path /auth /auth/* /channels /channels/* /users /users/* /socket.io /socket.io/* /uploads /uploads/* /bots /bots/* /api /api/* /reports /reports/* /search /search/* /push /push/* /audit-log /audit-log/* /calendar /calendar/* /dock /dock/* /commands /commands/* /gifs /gifs/* /roles /roles/*
	handle @backend {
		reverse_proxy backend:3001
	}

	# Lets a fresh device grab the LAN trust certificate before it has any
	# reason to trust this site yet: https://<host>/rootCA.pem
	handle /rootCA.pem {
		root * /etc/caddy/certs
		file_server
	}

	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy frontend:3000
	}
}
