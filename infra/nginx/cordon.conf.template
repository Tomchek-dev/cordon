# Cordon reverse-proxy block for a shared nginx server that already fronts
# other sites. Generated by setup.sh --behind-nginx. Caddy is not reachable
# directly - it's bound to 127.0.0.1:${CADDY_HTTPS_PORT} and only nginx talks
# to it, over HTTPS, with proxy_ssl_verify off (Caddy's cert is mkcert-issued,
# not from a public CA - that's expected and fine on this hop).
#
# Review this file, then install it:
#   sudo cp infra/nginx/cordon.conf /etc/nginx/sites-available/cordon.conf
#   sudo ln -s /etc/nginx/sites-available/cordon.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# You still need a certificate nginx itself will present to clients on the
# public listener below - either your existing cert for this host/domain, or
# (LAN-only setups) the same mkcert cert Cordon generated at
# infra/caddy/certs/lan.pem / lan-key.pem. Fill in ssl_certificate(_key) below.

server {
    listen 80;
    listen [::]:80;
    server_name ${LAN_HOSTNAME} ${LAN_IP};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${LAN_HOSTNAME} ${LAN_IP};

    # TODO: point these at this host's own certificate.
    ssl_certificate     /etc/ssl/certs/CHANGE-ME.pem;
    ssl_certificate_key /etc/ssl/private/CHANGE-ME-key.pem;

    location / {
        proxy_pass https://127.0.0.1:${CADDY_HTTPS_PORT};
        proxy_ssl_verify off;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for Socket.IO (WebSocket upgrade) and LiveKit signaling.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
